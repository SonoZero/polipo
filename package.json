{
  "name": "sonoprint",
  "productName": "SonoPrint",
  "version": "0.3.3",
  "description": "Controllo di più stampanti 3D da Windows e Mac: USB, Bambu Lab, Klipper, PrusaLink e OctoPrint",
  "main": "src/main.js",
  "author": "sonozero",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/SonoZero/polipo.git"
  },
  "scripts": {
    "start": "electron .",
    "server": "node scripts/server.js",
    "test": "node --test \"test/*.test.js\"",
    "dist": "electron-builder --win nsis portable --publish never",
    "dist:mac": "electron-builder --mac --publish never"
  },
  "dependencies": {
    "basic-ftp": "^6.2.1",
    "electron-updater": "^6.8.9",
    "mqtt": "^5.16.0",
    "multicast-dns": "^7.2.5",
    "qrcode": "^1.5.4",
    "serialport": "^13.0.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@phosphor-icons/core": "^2.1.1",
    "aedes": "^1.2.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "three": "^0.186.1"
  },
  "build": {
    "appId": "com.sonozero.sonoprint",
    "productName": "SonoPrint",
    "npmRebuild": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "build/icon.png",
      "THIRD-PARTY-NOTICES.md",
      "package.json"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "SonoZero",
        "repo": "polipo",
        "releaseType": "release"
      }
    ],
    "win": {
      "icon": "build/icon.png"
    },
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.utilities",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "artifactName": "SonoPrint-${version}-${arch}-mac.${ext}",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSCameraUsageDescription": "SonoPrint usa la webcam per mostrarti la stampante mentre stampa.",
        "NSLocalNetworkUsageDescription": "SonoPrint cerca e controlla le stampanti 3D nella rete di casa.",
        "NSBonjourServices": [
          "_octoprint._tcp",
          "_moonraker._tcp"
        ]
      }
    },
    "dmg": {
      "artifactName": "SonoPrint-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "SonoPrint",
      "artifactName": "SonoPrint-Setup-${version}.${ext}",
      "guid": "3cd096dc-3556-5638-bbda-b6bca43f503e"
    },
    "portable": {
      "artifactName": "SonoPrint-Portable-${version}.${ext}"
    }
  }
}
